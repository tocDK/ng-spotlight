{
  "name": "ng-spotlight-workspace",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Workspace for @tocdk/ng-spotlight and its kitchen sink.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tocDK/ng-spotlight.git"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve kitchen-sink",
    "build": "npm run build:lib && npm run build:demo",
    "build:lib": "ng build ng-spotlight --configuration=production",
    "postbuild:lib": "node -e \"const fs=require('fs');for(const f of ['README.md','LICENSE'])if(fs.existsSync(f))fs.copyFileSync(f,'dist/ng-spotlight/'+f)\"",
    "build:demo": "ng build kitchen-sink --configuration=production --base-href \"/ng-spotlight/\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:lib": "vitest run --project lib",
    "test:demo": "vitest run --project demo",
    "prestart": "node scripts/generate-example-sources.mjs",
    "prebuild:demo": "node scripts/generate-example-sources.mjs",
    "pretest": "node scripts/generate-example-sources.mjs",
    "pretest:coverage": "node scripts/generate-example-sources.mjs",
    "pretest:demo": "node scripts/generate-example-sources.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "lint": "eslint \"projects/**/*.ts\" \"projects/**/*.html\""
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.9.5",
    "@analogjs/vitest-angular": "^2.9.5",
    "@angular/build": "^21.2.29",
    "@angular/cdk": "^21.2.14",
    "@angular/cli": "^21.2.29",
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/compiler-cli": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@lingui/core": "^6.11.0",
    "@primeuix/themes": "^2.0.3",
    "@tocdk/lingui-angular": "github:tocDK/lingui-angular#v0.2.1",
    "@types/node": "^22.19.19",
    "@types/prismjs": "^1.26.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitest/coverage-v8": "^4.1.11",
    "ajv": "^8.17.1",
    "angular-eslint": "^21.4.0",
    "axe-core": "^4.11.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "jsdom": "^25.0.1",
    "marked": "^14.0.0",
    "ng-packagr": "^21.2.7",
    "prettier": "^3.8.3",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.10",
    "prismjs": "^1.29.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.11",
    "zone.js": "^0.15.1"
  }
}
