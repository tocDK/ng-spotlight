{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "newProjectRoot": "projects",
  "projects": {
    "ng-spotlight": {
      "projectType": "library",
      "root": "projects/ng-spotlight",
      "sourceRoot": "projects/ng-spotlight/src",
      "prefix": "spotlight",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": { "project": "projects/ng-spotlight/ng-package.json" },
          "configurations": {
            "production": { "tsConfig": "projects/ng-spotlight/tsconfig.lib.prod.json" },
            "development": { "tsConfig": "projects/ng-spotlight/tsconfig.lib.json" }
          },
          "defaultConfiguration": "production"
        }
      }
    },
    "kitchen-sink": {
      "projectType": "application",
      "root": "projects/kitchen-sink",
      "sourceRoot": "projects/kitchen-sink/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/kitchen-sink",
            "index": "projects/kitchen-sink/src/index.html",
            "browser": "projects/kitchen-sink/src/main.ts",
            "polyfills": [],
            "allowedCommonJsDependencies": ["prismjs"],
            "tsConfig": "projects/kitchen-sink/tsconfig.app.json",
            "assets": [],
            "styles": ["node_modules/primeicons/primeicons.css", "projects/kitchen-sink/src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                { "type": "initial", "maximumWarning": "1mb", "maximumError": "2mb" },
                { "type": "anyComponentStyle", "maximumWarning": "8kb", "maximumError": "16kb" }
              ]
            },
            "development": { "optimization": false, "extractLicenses": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": { "buildTarget": "kitchen-sink:build:production" },
            "development": { "buildTarget": "kitchen-sink:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
